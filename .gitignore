# ─────────────────────────────────────────────────────────────────────────────
# Lodestar — only ship what the addon (and CurseForge) actually needs.
# Dev tooling, build data, internal docs and art sources stay LOCAL.
# ─────────────────────────────────────────────────────────────────────────────

# Guide generator + validator + the large Questie data dumps (dev only).
# Exceções: o gerador e o teste do port para o Forever — quem revisa precisa rodar.
# Desde que a biblioteca inteira sai do banco do Forever, isso inclui o roteador.
tools/*
!tools/gen_forever.py
!tools/wdb.py
!tools/import_scan.py
!tools/import_forever.py
!tools/forever-guides.lua
!tools/forever-scan.lua
!tools/travel-tests.lua
!tools/race-tests.lua
!tools/splits-tests.lua
!tools/questiedb.py
!tools/build_intermediate.py
!tools/parse_lua.py
!tools/router.py
!tools/generate_all.py
!tools/gen_special.py
!tools/gen_zonedata.py
!tools/gen_trainers.py
!tools/gen_travel.py
!tools/gen_subzones.py
!tools/validate_guides.py
!tools/check_special.py
!tools/guide_integrity.py

# Internal documentation (not shipped) — specs, plans, design notes stay LOCAL
DSL.md
PACKAGING.md
# Exceção: o que o README linka.
docs/*
!docs/forever.md

# Art sources / previews — the shipped textures are the .tga files
*.zip
HUD-preview.html
lodestar-glyphs/*.png
lodestar-icones/*.png
Media/*.zip
Media/*.html

# Packager output
.release/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
*.swp
*~

# relatório de auditoria (local)
AUDIT_REPORT.html
!tools/casc.py
!tools/gen_terrain.py
