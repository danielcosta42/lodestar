package-as: Lodestar

enable-nolib-creation: no

# Comentário só em linha própria: o packager (BigWigsMods) não tira comentário
# do fim do item, e o "#"/";" que sobrava quebrava o eval da cópia — todo zip
# saía só com o CHANGELOG (issue #11).
ignore:
  # WoW só carrega .tga/.blp; os .png são só fonte
  - "**/*.png"
  # arte-fonte e preview de HUD
  - "Media/*.zip"
  # glifos que a interface não usa (ficam no repositório como fonte)
  - "lodestar-glyphs/chevron-cima-*.tga"
  - "lodestar-glyphs/chevron-dir-*.tga"
  - "lodestar-glyphs/chevron-esq-*.tga"
  - "lodestar-glyphs/combate-*.tga"
  - "lodestar-glyphs/escudo-*.tga"
  - "lodestar-glyphs/martelo-*.tga"
  - "lodestar-glyphs/moeda-*.tga"
  - "lodestar-glyphs/passo-atual-*.tga"
  - "lodestar-glyphs/faccao-*-128.tga"
  - "Media/*.html"
  # gerador Python + validador (dev only)
  - "tools"
  # notas internas (o README linka pelo GitHub)
  - "docs"
  # spec/plano/tarefas de cada feature (fluxo de desenvolvimento)
  - "specs"
  # doc interna do formato de guia
  - "DSL.md"
  - "PACKAGING.md"
  - ".pkgmeta"
  - ".gitignore"
  # workflows de CI/deploy
  - ".github"
